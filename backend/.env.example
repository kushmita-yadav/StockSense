APP_ENV=development
SECRET_KEY=replace-with-a-local-development-secret
DATABASE_URL=sqlite+aiosqlite:///./stocksense.db
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

OTP_EXPIRE_MINUTES=10
OTP_MAX_PER_HOUR=5

# Optional in development. If configured, otp_debug is never returned.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Production requires APP_ENV=production, a unique SECRET_KEY (32+ chars),
# COOKIE_SECURE=true, HTTPS CORS_ORIGINS, PostgreSQL, and SMTP settings.
# Example DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/stocksense
# For PostgreSQL test runs, separately set TEST_DATABASE_URL to a disposable test DB.
# Optional workspace dashboard assistant. Put the real key in backend/.env only.
# Keep this value blank in the tracked example; never expose the key to the browser.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
